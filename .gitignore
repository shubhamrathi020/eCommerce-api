# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

.claude/worktrees
.claude/settings.local.json
.nx/polygraph
.nx/self-healing
.nx/migrate-runs
.angular

vitest.config.*.timestamp*
# Angular / env
.angular
.env
.env.*
!.env.example

# Prisma-generated client (regenerated by `pnpm db:generate` / on build)
apps/api/generated/

# Real database dumps (BRD 24, OB-06's backup/restore drill) — may contain real data, never committed.
/backups/

# Kubernetes secret sources (BRD 25, K8-02) — kustomize's secretGenerator reads these; only the .example
# templates are committed, same pattern as apps/api/.env.example.
deploy/k8s/base/secrets/*.env
!deploy/k8s/base/secrets/*.env.example
deploy/k8s/data-tier/secrets/*.env
!deploy/k8s/data-tier/secrets/*.env.example

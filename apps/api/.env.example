# Copy to apps/api/.env for local development. Never put real secrets in this file (it is committed).

# Matches the `postgres` service in docker-compose.yml when running the API on your host and Postgres
# in a container: `localhost:5432`. Inside Docker Compose the API itself uses `postgres:5432` instead
# (set in docker-compose.yml directly, this file is only for running the API on the host).
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public"

REDIS_URL="redis://localhost:6379"

# Message broker (BRD 23). Matches the `rabbitmq` service in docker-compose.yml (default guest/guest
# creds, fine for local dev). Management UI at http://localhost:15672 once it's running.
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Catalog store (BRD 20). Matches the `mongo` service in docker-compose.yml when running on your host.
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="ecommerce_catalog"

# Search engine (BRD 20). Matches the `meilisearch` service in docker-compose.yml.
MEILI_URL="http://localhost:7700"
# Blank is fine for local development (Meilisearch runs without auth by default outside production).
MEILI_MASTER_KEY=""

# Online payments (BRD 21), optional. Leave blank to run with cash-on-delivery only; the API still starts.
# Get your own TEST-mode keys from the Razorpay dashboard (Settings > API Keys) - never a live key here,
# this project only ever runs in test mode. RAZORPAY_WEBHOOK_SECRET is the secret you set when adding the
# webhook URL in the dashboard (Settings > Webhooks), used to verify webhook calls are really from Razorpay.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Per-route rate limits (BRD 22), all optional — omit any of these to keep the built-in default shown here.
# Sign-in isn't listed: it's already covered by the 5-attempts/15-minutes-per-account lockout in AuthService.
# Blanket per-IP ceiling across every route (the original hardcoded value) — load tests from one machine hit this first.
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_SEARCH_PER_MIN=60
RATE_LIMIT_COUPON_PER_MIN=20
RATE_LIMIT_CHECKOUT_PER_MIN=20

# Minutes a cart can sit untouched before one abandoned-cart reminder email is sent (BRD 23), optional.
ABANDONED_CART_MINUTES=60

# Random strings, at least 32 characters. Generate your own for anything beyond local development,
# for example: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-only-access-secret-change-me-please-32chars"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me-please-32chr"

PORT=3333
NODE_ENV=development

# Comma-separated list of origins allowed to call this API with credentials.
CORS_ORIGINS="http://localhost:4200,http://localhost:4201"

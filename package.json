{
  "name": "@org/api-source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:api": "nx serve api",
    "db:generate": "prisma generate --config apps/api/prisma.config.ts --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --config apps/api/prisma.config.ts --schema apps/api/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --config apps/api/prisma.config.ts --schema apps/api/prisma/schema.prisma",
    "db:seed": "node --import tsx apps/api/prisma/seed.ts",
    "db:studio": "prisma studio --config apps/api/prisma.config.ts --schema apps/api/prisma/schema.prisma",
    "db:seed:catalog": "node --import tsx apps/api/scripts/seed-catalog.ts",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "verify": "nx run-many -t lint test build",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "k8s:render": "kubectl kustomize deploy/k8s/base",
    "backup": "node scripts/backup.mjs",
    "restore:drill": "node scripts/restore-drill.mjs"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/devkit": "23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/nest": "^23.2.1",
    "@nx/node": "23.2.1",
    "@nx/vite": "23.2.0",
    "@nx/vitest": "23.2.0",
    "@nx/webpack": "23.2.1",
    "@oxc-project/runtime": "^0.115.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/amqplib": "^0.10.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "dotenv": "^18.0.4",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "nx": "23.2.0",
    "prettier": "^3.8.1",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "tslib": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0"
  },
  "dependencies": {
    "@ecom/contracts": "github:shubhamrathi020/eCommerce-contracts#v0.1.0",
